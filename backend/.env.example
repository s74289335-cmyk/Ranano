# Copy this file to backend/.env and fill in real values for local dev.
# On Render, set these as environment variables in the service dashboard instead
# of committing a real .env file.

# Optional. Only needed if you want the "AI-generated background" feature on
# text-to-image generation. Get a free key at https://aistudio.google.com/apikey
# (free tier: ~500 requests/day as of writing). If unset, the app still works -
# it just generates the fruit alone with no background.
GEMINI_API_KEY=
